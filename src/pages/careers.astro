---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Careers" description="Interested in working at PureVida Water Technologies? Email contact@purevidawater.com for information about open roles.">
  <section class="min-h-[60vh] flex items-center justify-center bg-gradient-to-br from-sky-50 to-white">
    <div class="max-w-xl mx-auto px-4 py-16 text-center">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Careers at PureVida</h1>
      <p class="text-lg text-gray-600 mb-6">
        We're a local Texas team bringing bottle-less water, ice and coffee systems to businesses across Dallas-Fort Worth, Austin and San Antonio.
      </p>
      <p class="text-lg text-gray-600 mb-8">
        Interested in joining us? Email <a href="mailto:contact@purevidawater.com" class="text-sky-600 font-semibold underline">contact@purevidawater.com</a> for information about open roles.
      </p>
      <a href="mailto:contact@purevidawater.com?subject=Careers%20at%20PureVida" class="inline-block bg-sky-500 hover:bg-sky-600 text-white px-8 py-3 rounded-xl font-semibold transition shadow-lg shadow-sky-500/30">
        Email Us
      </a>
    </div>
  </section>
</Layout>
