---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for has moved. Taking you to the PureVida Water Technologies homepage.">
  <section class="min-h-[60vh] flex items-center justify-center bg-gradient-to-br from-sky-50 to-white">
    <div class="max-w-xl mx-auto px-4 text-center">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">This page has moved</h1>
      <p class="text-lg text-gray-600 mb-8">
        Taking you to our home page&hellip;
      </p>
      <a href="/" class="bg-sky-500 hover:bg-sky-600 text-white px-8 py-3 rounded-xl font-semibold transition shadow-lg shadow-sky-500/30">
        Go to Home Page
      </a>
    </div>
  </section>
  <script is:inline>
    // Payton 10/9: any old printed piece or unknown link lands on the home page.
    // Short delay so analytics still records which old address was used.
    setTimeout(function () { window.location.replace('/'); }, 1500);
  </script>
</Layout>
